# Copy this file to .env and adjust if needed.
DATABASE_URL="postgresql://shiplog:shiplog@localhost:5433/shiplog?schema=public"
DATABASE_URL_UNPOOLED="postgresql://shiplog:shiplog@localhost:5433/shiplog?schema=public"

# Production only: public URL of this app, e.g. https://shiplog.vercel.app
# (used in the install snippet and allowed as the /demo page origin when seeding)
# APP_URL="https://your-app.vercel.app"

# Optional AI features (duplicate detection + feedback summaries). Without these the
# app still works and falls back to text matching. Any OpenAI-compatible provider:
#   Groq (free tier):  AI_API_KEY="gsk_..."  AI_MODEL="qwen/qwen3.8-27b"  (check console.groq.com for current ids)
#   Ollama (local):    AI_BASE_URL="http://localhost:11434/v1"  AI_MODEL="llama3.1:8b"
# AI_API_KEY=""
# AI_BASE_URL=""
# AI_MODEL=""

# Optional "Continue with GitHub / Google". A button appears only when both values are set.
# Callback URLs to register with the provider:
#   https://<your-domain>/api/auth/github/callback   (GitHub OAuth app; one callback per app)
#   https://<your-domain>/api/auth/google/callback   (Google OAuth client; add localhost too)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
