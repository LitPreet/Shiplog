// Shiplog database schema.
// Run `npm run db:migrate` after changing this file to create a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app (serverless functions open many short-lived connections).
  url       = env("DATABASE_URL")
  // Direct connection for migrations (poolers can't run them). Locally both are the same URL.
  // Names match what the Vercel + Neon integration creates automatically.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// A person who signs in to the dashboard and owns projects.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  // scrypt hash, format "salt:hash" (see src/lib/password.ts). Never the password.
  passwordHash String
  createdAt    DateTime  @default(now())
  projects     Project[]
  sessions     Session[]
}

// Server-side sessions. The browser cookie holds a random token; we store only
// its SHA-256 hash, so a leaked DB dump can't be replayed as live logins.
// Logging out (or "sign out everywhere") is just deleting rows.
model Session {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A Project = one customer website that embeds the widget.
model Project {
  id             String     @id @default(cuid())
  name           String
  ownerId        String
  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Goes in the <script data-key="..."> tag. It is PUBLIC (anyone can read it
  // in page source), so it only unlocks low-risk actions: list/submit/vote.
  publicKey      String     @unique
  // Browser origins allowed to use this key, e.g. "https://acme.com".
  allowedOrigins String[]
  // Kill switch: when false the API rejects every widget request.
  isActive       Boolean    @default(true)

  // Widget appearance + form, editable from the dashboard. The widget fetches
  // these from GET /api/v1/config, so owners change them without re-pasting.
  widgetTitle      String @default("Share feedback")
  widgetSubtitle   String @default("Vote on ideas or suggest your own.")
  launcherText     String @default("Feedback")
  accentColor      String @default("#ff5b2e")
  // "light" | "dark" | "auto" (auto = follow the visitor's OS setting).
  widgetTheme      String @default("light")
  titleLabel       String @default("Your idea")
  titlePlaceholder String @default("e.g. Export reports to Excel")
  showDescription  Boolean @default(true)
  // Extra owner-defined form fields: FormField[] (see src/lib/form-fields.ts).
  // JSON because the shape is per-project and always read/written as a whole.
  formFields       Json   @default("[]")

  createdAt      DateTime   @default(now())
  feedback       Feedback[]

  @@index([ownerId])
}

enum FeedbackStatus {
  OPEN
  PLANNED
  IN_PROGRESS
  DONE
  CLOSED
}

model Feedback {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      FeedbackStatus @default(OPEN)
  // Denormalized counter: we could COUNT(votes) every time, but sorting the
  // board by votes is the hottest query, so we keep the number on the row and
  // update it in the same transaction as the Vote insert/delete.
  voteCount   Int            @default(0)
  // Anonymous ID of the end-user who submitted it (generated in the widget).
  visitorId   String
  // Page the feedback was submitted from.
  pageUrl     String?
  // Answers to the project's custom fields, as a snapshot:
  // [{ fieldId, label, value }]. Storing the label means old feedback still
  // reads correctly after the owner renames or deletes a field.
  answers     Json           @default("[]")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  votes       Vote[]

  @@index([projectId, voteCount])
}

model Vote {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  visitorId  String
  createdAt  DateTime @default(now())

  // One vote per visitor per item, enforced by the database itself
  // (not just app code), so double-clicks and races can't double count.
  @@unique([feedbackId, visitorId])
}
