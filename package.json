{
  "name": "shiplog",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w web",
    "db:seed": "npm run db:seed -w web",
    "dev:web": "npm run dev -w web",
    "dev:widget": "npm run dev -w @shiplog/widget",
    "build:widget": "npm run build -w @shiplog/widget"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "preact": "^10.29.8",
    "vite": "^6.4.6"
  }
}
